# Copy to `.env` and adjust. Everything is optional for local dev with SQLite.

# --- app ---
ENVIRONMENT=development            # development | test | production
# SECRET_KEY=                       # required (>=32 chars) in production
# DEBUG=true

# --- database ---
# DATABASE_URL=sqlite:///./placement.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/placement

# --- security ---
# SECRET_KEY=<random >= 32 chars>
# BCRYPT_ROUNDS=12
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=14
# FIELD_ENCRYPTION_KEY=             # required in production (Fernet key)

# --- institution (policy, not code) ---
# INSTITUTION_NAME=KLE Technological University
# INSTITUTION_CODE=KLE
# INSTITUTION_CONTACT_EMAIL=placementcell@kletech.example.edu
# INSTITUTION_ALLOW_SELF_REGISTRATION=true
# INSTITUTION_GRADING_SCALE_MAX=10.0

# --- cors ---
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- rate limiting ---
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_DEFAULT=120/minute
# RATE_LIMIT_AUTH=10/minute
# RATE_LIMIT_WRITE=40/minute
# RATE_LIMIT_UPLOAD=15/minute
# RATE_LIMIT_AI=20/minute
# RATE_LIMIT_TRUSTED_PROXY=          # comma-separated IPs/CIDRs allowed to set X-Forwarded-For

# --- document extraction limits ---
# MAX_EXTRACTED_TEXT_CHARS=200000
# MAX_PDF_PAGES=100
# MAX_DOCX_DECOMPRESSED_BYTES=31457280

# --- api docs & bulk import guards ---
# API_DOCS_ENABLE_PRODUCTION=false  # expose /docs & /redoc in production
# MAX_IMPORT_ROWS=500

# --- ai (advisory only; deterministic heuristic runs without a key) ---
# AI_ENABLED=true
# AI_PROVIDER=heuristic             # heuristic | openai_compatible | anthropic | local
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=

# --- seeding & misc ---
# SEED_ON_STARTUP=false             # set true to populate demo data on boot (dev only)
# SEED_ADMIN_EMAIL=admin@kle.local  # demo admin login (default admin@kle.local)
# SEED_ADMIN_PASSWORD=              # demo admin password; unset -> random, printed at seed time
# SEED_STUDENT_PASSWORD=            # demo student password; unset -> random, printed at seed time
# PAGINATION_DEFAULT_LIMIT=25